# Database Configuration
POSTGRES_DB=institution_erp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_PORT=5432

# Backend API Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5050
CONNECTION_STRING=Host=localhost;Port=5432;Database=institution_erp;Username=postgres;Password=root

# Security & Tokens
JWT_SECRET=SuperSecretKeyForInstitutionErpSystem2026!MustBeAtLeast32CharsLong
JWT_ISSUER=InstitutionErp
JWT_AUDIENCE=InstitutionErpUsers
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# Frontend Configuration
VITE_API_URL=http://localhost:5050/api/v1
PORT=3000
